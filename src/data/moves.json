  "moves": {
    "rook-strike": {
      "id": "rook-strike",
      "name": "Rook's overhead strike",
      "kind": "attack",
      "reach": { "forward": 60, "pierce": 8 },
      "note": "Rook's strike from Mark's frames, timed from the side-view spike (G-sf-rook-strike): a breath of idle, the dip, the stand-up in two steps, the overhead held, then four swing frames (the blade lands on the last tick of the fourth), the follow-through held through the hit and the way home. The spike counted in pose frames (25.6 ms each); here every hold is in ticks (16.7 ms): 1 pose frame is about 1.5 ticks. The lunge fractions are the spike's (0.10, 0.24, 0.38, 0.52, 0.66, 0.82, 1.0) rewritten as the distance covered during each frame. Startup 34, active 1, recovery 35 ticks.",
      "frames": [
        { "still": "$idle", "hold": 6, "label": "ready" },
        { "still": "rook.dip", "hold": 5, "move": { "dx": -0.03 }, "label": "dip" },
        { "still": "rook.riseA", "hold": 2, "move": { "dx": -0.005 }, "label": "stand up" },
        { "still": "rook.rise", "hold": 3, "move": { "dx": -0.01 } },
        { "still": "rook.windup", "hold": 7, "move": { "dx": -0.005 }, "label": "overhead wind-up" },
        { "still": "rook.smearA", "hold": 3, "move": { "dx": 0.25, "dz": 0.2 }, "label": "swing" },
        { "still": "rook.mid", "hold": 3, "move": { "dx": 0.3, "dz": 0.3 } },
        { "still": "rook.smearB", "hold": 2, "move": { "dx": 0.2, "dz": 0.2 } },
        { "still": "rook.swingB", "hold": 3, "move": { "dx": 0.3, "dz": 0.3 }, "front": true, "events": [{ "type": "hit", "at": 2, "stop": 7, "shake": 2, "effect": "cut", "weight": "heavy" }], "label": "impact" },
        { "still": "rook.followFade", "hold": 3, "front": true, "label": "follow-through" },
        { "still": "rook.follow", "hold": 14, "front": true },
        { "still": "rook.recover", "hold": 6, "move": { "dx": -0.35, "dz": -0.35 }, "label": "recover" },
        { "still": "$idle", "hold": 8, "move": { "dx": -0.45, "dz": -0.45 } },
        { "still": "$idle", "hold": 4, "move": { "dx": -0.2, "dz": -0.2 } }
      ]
    },
    "kit-punch": {
      "id": "kit-punch",
      "name": "Kit's jab, cross and kick",
      "kind": "attack",
      "reach": { "forward": 30, "pierce": 3 },
      "note": "Kit's three-blow combo from Mark's frames, from the side-view spike (H-sf-kit-punch): a run in to a far target, the load, the jab (light), the load again as the arm comes back, the cross (medium), the chamber, the kick (heavy, held through the damage), the foot coming down and the walk home. The combo is ONE action with ONE damage roll: the engine's single damage lands with the finisher, and the first two hits are only seen (spark, flinch, a short hitstop each). Pose frames of the spike converted at about 1.5 ticks each. Blows on ticks 22, 33 and 51 of 91. Fists and toe end 30 px in front of her axis; the kick's body is shoved 8 px forward to make up its shorter reach.",
      "frames": [
        { "still": "$idle", "hold": 4, "label": "guard" },
        { "still": "kit.run", "hold": 4, "offset": [0, -2], "move": { "dx": 0.3, "dz": 0.3 }, "label": "run in" },
        { "still": "kit.run", "hold": 4, "move": { "dx": 0.3, "dz": 0.3 } },
        { "still": "kit.run", "hold": 4, "offset": [0, -2], "move": { "dx": 0.26, "dz": 0.26 } },
        { "still": "kit.load", "hold": 3, "move": { "dx": 0.06, "dz": 0.06 }, "front": true, "label": "load" },
        { "still": "kit.jabS", "hold": 3, "move": { "dx": 0.02, "dz": 0.02 }, "front": true, "label": "jab" },
        { "still": "kit.jabT", "hold": 2, "offset": [1, 0], "front": true, "events": [{ "type": "hit", "at": 0, "stop": 3, "shake": 1, "effect": "spark" }], "label": "jab lands" },
        { "still": "kit.jab", "hold": 3, "offset": [1, 0], "move": { "dx": 0.02, "dz": 0.02 }, "front": true },
        { "still": "kit.load", "hold": 3, "front": true, "label": "coil" },
        { "still": "kit.crossS", "hold": 3, "move": { "dx": 0.01, "dz": 0.01 }, "front": true, "label": "cross" },
        { "still": "kit.crossT", "hold": 2, "offset": [2, 0], "move": { "dx": 0.01, "dz": 0.01 }, "front": true, "events": [{ "type": "hit", "at": 0, "stop": 6, "shake": 2, "effect": "spark", "weight": "heavy" }], "label": "cross lands" },
        { "still": "kit.cross", "hold": 5, "offset": [2, 0], "move": { "dx": 0.02, "dz": 0.02 }, "front": true },
        { "still": "kit.load", "hold": 3, "offset": [2, 0], "front": true, "label": "chamber" },
        { "still": "kit.kickC", "hold": 5, "offset": [4, 0], "front": true },
        { "still": "kit.kickS", "hold": 3, "offset": [7, 0], "front": true, "label": "kick" },
        { "still": "kit.kickT", "hold": 2, "offset": [8, 0], "front": true, "events": [{ "type": "hit", "at": 0, "stop": 8, "shake": 3, "effect": "cut", "weight": "heavy" }], "label": "kick lands" },
        { "still": "kit.kick", "hold": 15, "offset": [8, 0], "front": true },
        { "still": "kit.kickD", "hold": 3, "offset": [7, 0], "front": true },
        { "still": "kit.kickE", "hold": 3, "offset": [4, 0] },
        { "still": "kit.load", "hold": 3, "move": { "dx": -0.1, "dz": -0.1 }, "label": "settle" },
        { "still": "$idle", "hold": 14, "move": { "dx": -0.9, "dz": -0.9 } }
      ]
    },
