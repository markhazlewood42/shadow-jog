  "npcs": [
    {"id":"km_cop","x":3,"y":11,"dir":"right","look":"corpsec","name":"K-M Civic Security","fixedDir":false,"talk":["Lower Wards Access Point Seven is closed by order of Kessler-Mori Civic Security.","Registered residents may apply for a transit waiver. Processing time: six to eighteen months. Move along."]},
    {"id":"p1","x":20,"y":23,"dir":"down","look":{"body":"short","skin":"#a5673f","hair":"#1a1418","hairStyle":"slick","top":"#b8b0a0","accent":"#62e06a","pants":"#3a3448","boots":"#1a1418","accessories":[],"coat":"#b8b0a0","mouth":"line","brows":true},"name":"Local","move":"wander","radius":3,"talk":["The lanterns are for the Drowned Festival. Every year we light one for everyone the flood took. Lot of lanterns."]},
    {"id":"p2","x":33,"y":24,"dir":"down","look":{"body":"std","skin":"#5a3624","hair":"#2e1d33","hairStyle":"bun","top":"#8c2f39","accent":"#ffcc3d","pants":"#4a3a30","boots":"#1a1418","accessories":["elfears"],"mouth":"line","brows":false,"stance":"crossed","umbrella":"#6a3fa0"},"name":"Local","move":"wander","radius":3,"talk":["My cousin went in for a K-M “aptitude screening” last spring. They said he tested gifted. We haven’t heard from him since."]},
    {"id":"p3","x":24,"y":28,"dir":"down","look":{"body":"std","skin":"#eadbd0","hair":"#c9c4bb","hairStyle":"bun","top":"#a0652f","accent":"#3fe0f0","pants":"#3d3a30","boots":"#2a2420","accessories":[],"mouth":"grin","brows":true,"umbrella":"#3a3a44"},"name":"Local","move":"wander","radius":3,"talk":["Heading to the Rustyard? Go east out of the Row, follow the old highway, then cut across the Barrens. Watch for scrap hounds."]},
    {"id":"p4","x":38,"y":29,"dir":"down","look":{"body":"std","skin":"#c98a5e","hair":"#1a1418","hairStyle":"slick","top":"#b8b0a0","accent":"#3fe0f0","pants":"#1e1c26","boots":"#3a2a2a","accessories":[],"inner":"#b8b0a0","mouth":"line","brows":true,"umbrella":"#b07cff","umbrellaClear":true},"name":"Local","move":"wander","radius":3,"talk":["Eight hours on the pumps, two in the noodle queue. Whatever you’re selling, I’m not buying."]},
    {"id":"p5","x":10,"y":8,"dir":"down","look":{"body":"short","skin":"#a5673f","hair":"#e8d070","hairStyle":"ponytail","top":"#2f6a5a","accent":"#ff4fb0","pants":"#3a3448","boots":"#3a2a2a","accessories":[],"mouth":"grin","brows":false,"stance":"phone","umbrella":"#1a1822"},"name":"Local","move":"wander","radius":3,"talk":["The Sinkline station’s south of here, across the canal. Folks say the water down there moves by itself."]},
    {"id":"p6","x":45,"y":14,"dir":"down","look":{"body":"std","skin":"#7a4a30","hair":"#8a5a2e","hairStyle":"bald","top":"#7a2e5a","accent":"#b07cff","pants":"#2a2a33","boots":"#3a2a2a","accessories":[],"coat":"#7a2e5a","mouth":"none","brows":true,"stance":"crossed","umbrella":"#3a3a44"},"name":"Local","move":"wander","radius":3,"talk":["Watch yourself east of here. Rustfangs have been collecting “tolls” on anyone walking alone."]},
    {"id":"p7","x":30,"y":8,"dir":"down","look":{"body":"std","skin":"#f2c9a5","hair":"#2e1d33","hairStyle":"bald","top":"#4d5238","accent":"#62e06a","pants":"#2b3350","boots":"#3a2a2a","accessories":[],"coat":"#4d5238","mouth":"line","brows":false,"stance":"crossed","umbrella":"#ffcc3d","umbrellaClear":true},"name":"Local","move":"wander","radius":3,"talk":["If you’ve got a shaman friend and a deck-jockey friend, have ’em try working together. Spirits love a power surge. Or so I hear."]},
    {"id":"p8","x":16,"y":33,"dir":"down","look":{"body":"std","skin":"#e0b08a","hair":"#1a1418","hairStyle":"hood","top":"#a0652f","accent":"#62e06a","pants":"#2a2a33","boots":"#2a2420","accessories":["elfears"],"mouth":"line","brows":true},"name":"Local","move":"static","radius":3,"talk":["Autocabs will take you back to town from anywhere on the street. Cab Vouchers at the Kwik-Mart. Worth every cred."]},
    {"id":"skewer","x":19,"y":17,"dir":"down","look":{"body":"std","skin":"#f2c9a5","hair":"#d8452e","hairStyle":"slick","top":"#2c3b5e","accent":"#3fe0f0","pants":"#1e1c26","boots":"#2a2420","accessories":[],"inner":"#8c2f39","mouth":"none","brows":true,"stance":"crossed"},"name":"Skewer Vendor","fixedDir":true,"talk":["Rat-on-a-stick! Not glowrat, no no. Regular rat. Organic! Very fresh!"]},
    {"id":"junk","x":32,"y":17,"dir":"down","look":"mags","name":"Hedda’s Cart","fixedDir":true,"talk":"junk_talk"},
    {"id":"fetish","x":35,"y":25,"dir":"down","name":"Charm Seller","fixedDir":true,"look":{"skin":"#8a9a6a","hair":"#e8e4da","hairStyle":"long","top":"#6a3fa0","inner":"#3a2a24","accent":"#d9b36c","pants":"#4a3a30","boots":"#2a2020","accessories":["tusks"]},"talk":["Charms against spirits, charms against corps. The corp ones don’t work, but they make people feel better.","You smell of something waking, girl. Careful. Kessler-Mori pays well for people who smell like that."]},
    {"id":"q_skewer","x":19,"y":19,"dir":"up","look":{"body":"std","skin":"#f2c9a5","hair":"#4a2e22","hairStyle":"ponytail","top":"#4d5238","accent":"#d9b36c","pants":"#4a3a30","boots":"#2a2420","accessories":[],"mouth":"line","brows":true,"stance":"crossed"},"name":"Local","move":"static","radius":3,"talk":["Two sticks. No, the organic ones. …What do you mean they’re all organic?"]},
    {"id":"q_junk","x":32,"y":19,"dir":"up","look":{"body":"big","skin":"#7a8a5e","hair":"#2e1d33","hairStyle":"short","top":"#5a5f7a","accent":"#d9b36c","pants":"#2a2a33","boots":"#3a2a2a","accessories":["tusks"],"coat":"#5a5f7a","cyberArm":"left","mouth":"none","brows":true,"stance":"phone"},"name":"Local","move":"static","radius":3,"talk":["I’m just looking. I’ve been just looking for three hours."]},
    {"id":"q_charm","x":35,"y":27,"dir":"up","look":{"body":"std","skin":"#f2c9a5","hair":"#2e1d33","hairStyle":"cap","top":"#7a2e5a","accent":"#d9b36c","pants":"#1e1c26","boots":"#2a2420","accessories":["elfears"],"inner":"#1d5c6a","hat":"#2f6a5a","mouth":"grin","brows":true,"stance":"phone"},"name":"Local","move":"static","radius":3,"talk":["One for my sister. She’s got a K-M aptitude screening Tuesday."]},
    {"id":"mourner","x":28,"y":27,"dir":"up","look":{"body":"std","skin":"#5a3624","hair":"#c9c4bb","hairStyle":"bob","top":"#2c3b5e","accent":"#62e06a","pants":"#3d3a30","boots":"#3a2a2a","accessories":[],"inner":"#4d5238","cyberArm":"right","mouth":"line","brows":false,"stance":"crossed"},"name":"Local","move":"static","radius":3,"talk":["There’s a lantern here for every name. My mother counted them every year. Now I do."]},
    {"id":"gossip_a","x":20,"y":28,"dir":"right","look":{"body":"short","skin":"#f2c9a5","hair":"#8a5a2e","hairStyle":"ponytail","top":"#8c2f39","accent":"#b07cff","pants":"#2a2a33","boots":"#2a2420","accessories":[],"coat":"#8c2f39","mouth":"none","brows":true,"stance":"crossed"},"name":"Local","move":"static","radius":3,"talk":["They say the Rustfangs got a new boss. Big guy. Calls himself Knuckles."]},
    {"id":"gossip_b","x":21,"y":28,"dir":"left","look":{"body":"std","skin":"#7a4a30","hair":"#c9c4bb","hairStyle":"long","top":"#1d5c6a","accent":"#d9b36c","pants":"#2a2a33","boots":"#3a2a2a","accessories":[],"mouth":"line","brows":false},"name":"Local","move":"static","radius":3,"talk":["They always say that. It’s always a big guy."]},
    {"id":"kids","x":26,"y":26,"dir":"up","look":{"body":"std","skin":"#e0b08a","hair":"#d8452e","hairStyle":"bun","top":"#5a5f7a","accent":"#b07cff","pants":"#4a3a30","boots":"#3a2a2a","accessories":["elfears"],"inner":"#2f6a5a","coat":"#5a5f7a","mouth":"line","brows":true,"stance":"crossed"},"name":"Kid","move":"wander","radius":2,"talk":["Mom says don’t talk to runners. …Are you runners? Mom says runners disappear."]}
