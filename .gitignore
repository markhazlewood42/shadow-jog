# Session tooling output (scripts/evidence.sh, scripts/verifier-prompts.py)
evidence.log
reviewer-prompts/
# Trailer recordings and previews (scripts/trailer.mjs): too big for a public repo; re-shoot them instead.
media/

# Local secrets (API keys, e.g. PIXELLAB_API_KEY): never committed, this repo is public.
.env
.env.*

# Vercel CLI link (project and org ids, local only)
.vercel

# Default-path goldens (e2e/default-path.spec.ts): the soft set (SwiftShader, what CI runs) is committed; the gpu set is made locally.
tests/fixtures/defaultpath/gpu/

# The local reporter (tools/command-center/scripts/reporter-launch.mjs): its pinned copy of origin/main, lock, log and generated config. No secrets.
.cc-reporter/

# The Battle Stage Editor save endpoint's test seam (?scratch=<name>, src/dev/stageedit/serve.ts): private copies of the stage files, made by the specs and deleted by them.
tests/fixtures/stagedata/.scratch/
