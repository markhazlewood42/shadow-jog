{
  "name": "shadow-jog-command-center",
  "private": true,
  "version": "0.1.0",
  "description": "Shadow Jog Command Center: a local website for the status, the docs and the design decisions of Shadow Jog",
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "cc": "vite build && tsx src/server/main.ts",
    "dev": "tsx watch src/server/main.ts --dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@hono/node-server": "2.1.3",
    "chokidar": "5.0.0",
    "github-slugger": "2.0.0",
    "hono": "4.13.13",
    "lucide-react": "1.52.0",
    "markdown-it": "15.0.2",
    "minisearch": "7.2.0",
    "open": "11.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tsx": "4.23.15",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
