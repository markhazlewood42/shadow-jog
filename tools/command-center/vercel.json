{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "VITE_HOSTED=1 vite build",
  "outputDirectory": "dist",
  "ignoreCommand": "node scripts/vercel-ignore.mjs",
  "git": {
    "deploymentEnabled": { "**": false, "main": true }
  },
  "functions": {
    "api/*.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/docs/:path*", "destination": "/api/docs?path=:path*" },
    { "source": "/((?!api/|api$).*)", "destination": "/index.html" }
  ]
}
