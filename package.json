{
  "name": "shadow-jog",
  "private": true,
  "version": "0.1.0",
  "description": "SHADOW JOG \u2014 a cyberpunk-fantasy JRPG for the browser",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3007",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3008",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shots": "playwright test e2e/shots.spec.ts",
    "check": "biome lint && tsc --noEmit && vitest run",
    "lint": "biome lint",
    "budget": "vite build && node scripts/bundle-budget.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
